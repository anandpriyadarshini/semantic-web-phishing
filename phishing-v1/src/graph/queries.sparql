# ───────────────────────────────────────────────────────────────────
# SPARQL queries for phishing infrastructure correlation
# Run against the RDF graph built by build_graph.py
# ───────────────────────────────────────────────────────────────────

PREFIX phish: <http://example.org/phishing-ontology#>
PREFIX inst:  <http://example.org/phishing-instance#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

# ── Query 1: Find all phishing URLs that share an IP address ──────
# SELECT ?url1 ?url2 ?ip
# WHERE {
#     ?u1 a phish:URL ;
#         phish:urlString ?url1 ;
#         phish:label "1"^^xsd:integer ;
#         phish:hasDomain ?d1 .
#     ?u2 a phish:URL ;
#         phish:urlString ?url2 ;
#         phish:label "1"^^xsd:integer ;
#         phish:hasDomain ?d2 .
#     ?d1 phish:resolvesTo ?ipNode .
#     ?d2 phish:resolvesTo ?ipNode .
#     ?ipNode phish:ipValue ?ip .
#     FILTER(?u1 != ?u2)
# }

